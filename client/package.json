{
  "name": "vibeos",
  "version": "1.0.0",
  "description": "macOS simulator in the browser",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && tsc -p electron-tsconfig.json && electron .\"",
    "electron:build": "vite build && tsc -p electron-tsconfig.json && electron-builder"
  },
  "dependencies": {
    "@webcontainer/api": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.4",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "wait-on": "^9.1.0"
  }
}
